# ==============================================================================
# 1. EXECUTION & STORAGE MODE
# ==============================================================================
# Storage backend: "duckdb" (zero-Docker standalone 1M-row OLAP) or "dual" (PostgreSQL + DuckDB/Parquet)
STORAGE_MODE=duckdb
DUCKDB_PATH=data/lakehouse/dach_leads.duckdb
PARQUET_EXPORT_PATH=data/lakehouse/companies_1m.parquet
SHOWCASE_PARQUET_PATH=data/samples/leads_showcase.parquet
SHOWCASE_CSV_PATH=data/samples/leads_showcase.csv

# ==============================================================================
# 2. DISTRIBUTED CLUSTER INFRASTRUCTURE (Docker Compose / scrapy-redis)
# ==============================================================================
USE_REDIS_FRONTIER=false
REDIS_URL=redis://localhost:6379/0
REDIS_START_URLS_KEY=dach_leadgen:start_urls

POSTGRES_DSN=postgresql://leadgen:leadgen_secret@localhost:5432/dach_leads
PIPELINE_BATCH_SIZE=500

# ==============================================================================
# 3. SCRAPY CONCURRENCY & ADAPTIVE ANTI-BOT ESCALATION
# ==============================================================================
CONCURRENT_REQUESTS=64
CONCURRENT_REQUESTS_PER_DOMAIN=2
DOWNLOAD_TIMEOUT_SECONDS=15
MAX_PAGES_PER_DOMAIN=3

# Tier 2: curl_cffi Chrome TLS JA3/JA4 impersonation on 403/429/503/WAF (or force globally)
CURL_CFFI_IMPERSONATE=chrome124
FORCE_CURL_CFFI=false

# Tier 3: Optional Camoufox headless browser fallback for heavy JS SPAs
ENABLE_BROWSER_FALLBACK=false

# ==============================================================================
# 4. SEEDING & LEAD SCORING THRESHOLDS
# ==============================================================================
OFFENEREGISTER_DUMP_URL=https://daten.offeneregister.de/de_companies_ocdata.jsonl.bz2
TRANCO_TOP_1M_URL=https://tranco-list.eu/top-1m.csv.zip
DEFAULT_SEED_ROWS=1000000
HOT_LEAD_SCORE_THRESHOLD=75

# ==============================================================================
# 5. FASTAPI LEAD EXPLORER & N8N INTEGRATION
# ==============================================================================
WEB_HOST=127.0.0.1
WEB_PORT=8765
N8N_WEBHOOK_URL=
